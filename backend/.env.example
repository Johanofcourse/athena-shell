# DeepSeek powers the natural-language query layer (OpenAI-compatible API).
# Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Free key: https://data.bls.gov/registrationEngine
BLS_API_KEY=

# For the planned FRED (FHFA House Price Index by metro) ingest, not built yet.
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

DATABASE_URL=sqlite:///./athena.db

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# Comma-separated list of IPs exempt from the free daily query cap
# (see app/usage.py), beyond loopback - e.g. your own IP, for testing
# that shouldn't count against real visitor traffic. Leave empty by
# default; set this directly in the real .env on the server, never here.
EXEMPT_IPS=
